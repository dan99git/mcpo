# Copy this file to the repository root as .env.gateway-poc.
# Set the assigned site ID and public domains, then replace both secret values.
# Do not commit the resulting file.
BOS_VENDOR_SITE_ID=44354
MCPO_GATEWAY_PUBLIC_DOMAIN=gateway.ai.lighting
VENDOR_PUBLIC_DOMAIN=ai.lighting
MCPO_GATEWAY_CONSENT_KEY=replace-with-a-long-random-consent-key
BOS_VENDOR_SITE_ACCESS_KEY=replace-with-the-site-44354-access-key
