FROM python:3.12-slim-bookworm

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY pyproject.toml README.md LICENSE THIRD_PARTY_NOTICES.md ./
COPY src ./src
COPY static ./static
COPY skills/skill-creator ./skills/skill-creator
COPY skills/skill-installer ./skills/skill-installer

RUN uv venv /opt/mcpo-venv \
    && uv pip install --python /opt/mcpo-venv/bin/python . \
    && rm -rf /root/.cache/uv

ENV PATH="/opt/mcpo-venv/bin:${PATH}" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN useradd --create-home --uid 10001 mcpo \
    && mkdir -p /data \
    && chown mcpo:mcpo /data

USER mcpo
WORKDIR /data

EXPOSE 8351

ENTRYPOINT ["python", "-m", "mcpo.proxy"]
