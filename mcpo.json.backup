{
  "config": {
    "mcpServers": {
      "chrome-devtools": {
        "enabled": true,
        "command": "npx",
        "args": [
          "-y",
          "chrome-devtools-mcp@latest"
        ]
      },
      "memory": {
        "enabled": true,
        "command": "npx",
        "args": [
          "-y",
          "@modelcontextprotocol/server-memory"
        ]
      },
      "perplexity": {
        "enabled": true,
        "command": "npx",
        "args": [
          "-y",
          "perplexity-mcp"
        ],
        "env": {
          "PERPLEXITY_API_KEY": "${PERPLEXITY_API_KEY}"
        },
        "autoApprove": [
          "search",
          "reason",
          "deep_research"
        ]
      },
      "xero": {
        "enabled": true,
        "command": "npx",
        "args": [
          "-y",
          "@xeroapi/xero-mcp-server@latest"
        ],
        "env": {
          "XERO_CLIENT_ID": "${XERO_CLIENT_ID}",
          "XERO_CLIENT_SECRET": "${XERO_CLIENT_SECRET}"
        }
      },
      "playwright": {
        "enabled": true,
        "command": "npx",
        "args": [
          "-y",
          "@playwright/mcp@latest"
        ]
      },
      "time": {
        "enabled": true,
        "command": "uvx",
        "args": [
          "mcp-server-time"
        ]
      },
      "echo-server": {
        "enabled": true,
        "command": "npx",
        "args": [
          "-y",
          "@modelcontextprotocol/server-everything"
        ],
        "autoApprove": [
          "echo"
        ]
      },
      "filesystem": {
        "enabled": true,
        "command": "cmd",
        "args": [
          "/c",
          "npx",
          "-y",
          "@modelcontextprotocol/server-filesystem",
          "C:\\Users\\danie\\building-os"
        ]
      },
      "desktop-commander": {
        "enabled": true,
        "command": "node",
        "args": [
          "D:\\vibe-coded-projects\\mcpo\\tools\\mcp-node-tools\\node_modules\\@wonderwhy-er\\desktop-commander\\dist\\index.js"
        ]
      },
      "powershell-mcp": {
        "enabled": true,
        "command": "pwsh",
        "args": [
          "-NoLogo",
          "-NoProfile",
          "-Command",
          "Import-Module PowerShell.MCP -RequiredVersion 1.7.6 -ErrorAction Stop; & (Get-MCPProxyPath)"
        ]
      },
      "xero-code-mode": {
        "enabled": true,
        "command": "node",
        "args": [
          "C:/Users/danie/repos/xero-code-mode/dist/index.js"
        ]
      },
      "kicad": {
        "enabled": true,
        "command": "C:/Users/danie/AppData/Local/Microsoft/WinGet/Packages/astral-sh.uv_Microsoft.Winget.Source_8wekyb3d8bbwe/uvx.exe",
        "args": [
          "--python",
          "3.13",
          "--with",
          "cairosvg",
          "--with",
          "pillow",
          "kicad-mcp-pro==3.25.0",
          "serve",
          "--transport",
          "stdio",
          "--profile",
          "agent_full",
          "--mode",
          "experimental",
          "--no-telemetry"
        ],
        "env": {
          "KICAD_MCP_WORKSPACE_ROOT": "C:/Users/danie/building-os/hardware",
          "KICAD_MCP_KICAD_CLI": "C:/Users/danie/AppData/Local/Programs/KiCad/10.0/bin/kicad-cli.exe"
        }
      },
      "workspace-mcp": {
        "enabled": true,
        "type": "streamable-http",
        "url": "http://localhost:7733/mcp"
      },
      "workspaceFiles": {
        "enabled": true,
        "command": "npx",
        "args": [
          "-y",
          "@modelcontextprotocol/server-filesystem",
          "C:/Users/danie/repos/ai-pcb"
        ]
      },
      "kicad-cli": {
        "enabled": true,
        "command": "D:/vibe-coded-projects/mcpo/.venv/Scripts/python.exe",
        "args": [
          "D:/vibe-coded-projects/mcpo/tools/cli-shim/cli_shim.py",
          "D:/vibe-coded-projects/mcpo/tools/cli-shim/specs/kicad-cli.json"
        ]
      },
      "x": {
        "enabled": true,
        "type": "streamable-http",
        "url": "https://api.x.com/mcp",
        "headers": {
          "Authorization": "Bearer ${X_BEARER_TOKEN}"
        }
      }
    }
  },
  "server": "mcpo"
}
