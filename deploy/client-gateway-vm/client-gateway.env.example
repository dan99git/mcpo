# Reference values for one-time Building OS client enrollment inside the guest.
# Do not populate this repository file. Set the values only in the guest's
# interactive PowerShell session and clear the enrollment token afterwards.
BOS_VENDOR_RELAY_URL=wss://replace-with-vendor-host/relay/connect
BOS_VENDOR_SITE_NAME=replace-with-client-site-name
BOS_VENDOR_ENROLLMENT_TOKEN=replace-with-one-time-token
BOS_CHATGPT_MCP_PORT=7087

# The installer generates the local MCP key. The connector persists its own
# credential through Windows DPAPI. Neither credential belongs in this file.
